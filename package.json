{
  "name": "seolith-walk-in",
  "version": "0.1.0",
  "private": true,
  "description": "Walk In App — photorealistic 3D establishments with realtime inventory, voice/search/AI UX, and a portable API for robots.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "worker:photogrammetry": "tsx workers/photogrammetry.ts",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "build:cloudflare": "cp next.config.cloudflare.js next.config.js && mv app/api /tmp/walkin-api && next build; mv /tmp/walkin-api app/api; cp -r functions out/",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy out"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1099.0",
    "@aws-sdk/client-ses": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1099.0",
    "@prisma/adapter-d1": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "^10.0.0-rc.1",
    "@react-three/fiber": "^9.0.0-alpha.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.0.0",
    "ioredis": "^5.11.1",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.25",
    "next-pwa": "^5.6.0",
    "openai": "^4.80.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.4.0",
    "three": "^0.172.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@eslint/eslintrc": "^3.3.6",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.172.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.22",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
