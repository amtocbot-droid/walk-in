# Walk In — environment variables
# Copy to .env.local for development

# Next.js
NEXT_PUBLIC_APP_NAME=Walk In
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker / deployment
# AUTH_SECRET is required in production; generate with openssl rand -base64 32
# AUTH_SECRET=

# AI (optional for local resolver; required for production AI guide)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Skybox AI (360° scene generation)
# SKYBOX_API_KEY=
# SKYBOX_API_URL=https://api.blockadelabs.com/v1

# Local Stable Diffusion (free alternative)
# Run ComfyUI locally and set the API URL
# Requires a checkpoint model in ComfyUI/models/checkpoints/
# SD_API_URL=http://127.0.0.1:8188

# Email (AWS SES)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=noreply@walkin.app

# Photogrammetry backend
# Use "placeholder" for the local Three.js preview, or "cloud" for a real photogrammetry API.
PHOTOGRAMMETRY_BACKEND=placeholder
PHOTOGRAMMETRY_CLOUD_NAME=custom
PHOTOGRAMMETRY_UPLOAD_URL=
PHOTOGRAMMETRY_STATUS_URL_TEMPLATE=
PHOTOGRAMMETRY_DOWNLOAD_URL_TEMPLATE=
PHOTOGRAMMETRY_API_KEY=
PHOTOGRAMMETRY_API_KEY_HEADER=Authorization
PHOTOGRAMMETRY_POLL_INTERVAL_MS=5000
PHOTOGRAMMETRY_MAX_POLLS=60

# Auth (choose one)
# AUTH_SECRET=            # Auth.js / NextAuth
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=

# Database / Cache
DATABASE_URL=postgresql://walkin:walkin@localhost:5432/walkin
REDIS_URL=redis://localhost:6379

# S3 asset storage
# AWS_REGION=
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Telemetry / Analytics
TELEMETRY_PROVIDER=console
# TELEMETRY_DISTINCT_ID=

# PostHog
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Segment
# SEGMENT_WRITE_KEY=

# Google Analytics 4
# GA4_MEASUREMENT_ID=
# GA4_API_SECRET=

# Payments / Billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_YEARLY=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=
# STRIPE_PRICE_ENTERPRISE_YEARLY=
